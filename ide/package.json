{
  "name": "mesh-workspace",
  "displayName": "Mesh",
  "description": "Your shared knowledge graph, search and notes inside the editor.",
  "version": "0.2.3",
  "publisher": "bright-interaction",
  "license": "SEE LICENSE IN LICENSE",
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:mesh.workspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [
      { "command": "mesh.open", "title": "Open", "category": "Mesh", "icon": "$(symbol-misc)" },
      { "command": "mesh.refresh", "title": "Refresh View", "category": "Mesh" },
      { "command": "mesh.configureServer", "title": "Set Viewer URL", "category": "Mesh" },
      { "command": "mesh.signIn", "title": "Sign In to Remote Viewer", "category": "Mesh" },
      { "command": "mesh.signOut", "title": "Sign Out of Remote Viewer", "category": "Mesh" },
      { "command": "mesh.configureStartup", "title": "Configure Viewer Startup", "category": "Mesh" },
      { "command": "mesh.checkUpdates", "title": "Check for IDE Updates", "category": "Mesh" }
    ],
    "configuration": {
      "title": "Mesh",
      "properties": {
        "mesh.startup": {
          "type": "object", "scope": "machine", "default": { "enabled": false },
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "binary": { "type": "string" },
            "vault": { "type": "string" }
          },
          "description": "Opt-in, user-level read-only startup. Configure with Mesh: Configure Viewer Startup. Only absolute local executable/vault paths are accepted; workspace overrides are ignored. Existing listeners are never stopped."
        },
        "mesh.viewerUrl": {
          "type": "string", "default": "http://127.0.0.1:7474", "scope": "machine",
          "description": "Mesh viewer URL: HTTPS for remote servers, HTTP numeric loopback for local viewers. Root URLs also try /app on 404. Remote access keys use secure storage via Mesh: Sign In to Remote Viewer. Only the user-level value is used; workspace settings cannot redirect requests. Remote connections never launch a local process."
        }
      }
    }
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "test": "bun test ./test",
    "test:https": "bun test ./integration/https.test.js",
    "package": "bun scripts/package.mjs",
    "ci": "bun scripts/ci.mjs",
    "release:plan": "bun scripts/release-plan.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.2",
    "fflate": "0.8.2"
  }
}
